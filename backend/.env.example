# Backend environment variables
# Copy this file to .env and edit if needed:
#   cp .env.example .env
#
# These are read by app/core/config.py (pydantic Settings).

# PostgreSQL connection string. REQUIRED — the app does not support SQLite.
#
# The default points at the local Postgres container started by
# 'docker compose up -d' (host port 5433, container port 5432, user/db
# 'smartrecruiter', password 'smartrecruiter'). If you run a native Postgres
# on the standard 5432 port, change the port to 5432.
DATABASE_URL=postgresql+psycopg://smartrecruiter:smartrecruiter@localhost:5433/smartrecruiter

# JWT signing secret. Change this in production.
jwt_secret=dev-secret-change-me

# Codewars public API base URL (used by app/services/codewars_service.py)
codewars_base_url=https://www.codewars.com/api/v1

# Email / SMTP settings for sending invitation emails.
# For development without a real SMTP server, leave smtp_host as localhost
# and use a tool like MailHog or run the app with email sending disabled.
smtp_host=localhost
smtp_port=587
smtp_username=
smtp_password=
smtp_use_tls=true
sender_email=noreply@smartrecruiter.com
sender_name=Smart Recruiter

# Base URL of the frontend, used to build invitation links in emails.
frontend_base_url=http://localhost:5173
