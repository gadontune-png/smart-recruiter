# Backend environment example — copy to `.env` and adjust the values.
# Never commit the real `.env` (it is git-ignored).

PROJECT_NAME=Smart Recruiter API

# All API routes are mounted under this prefix -> /api
API_V1_PREFIX=/api

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_recruiter

# JWT settings
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS origins (comma separated) — frontend dev servers
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
