# Backend environment variables
# Copy this file to .env and edit if needed:
#   cp .env.example .env
#
# These are read by app/core/config.py (pydantic Settings).

# Database URL. Default uses a SQLite file inside the backend/ folder.
# To switch to PostgreSQL, use: postgresql+psycopg2://USER:PASS@localhost:5432/smart_recruiter
DATABASE_URL=sqlite:///./dev_smart_recruiter.db

# JWT signing secret. Change this in production.
jwt_secret=dev-secret-change-me

# Codewars public API base URL (used by app/services/codewars_service.py)
codewars_base_url=https://www.codewars.com/api/v1
